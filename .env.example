# MPLADS AI Sentinel Environment Configuration Example
# Copy to .env and adjust values for your environment.

# Application Environment (development / staging / production)
ENVIRONMENT=development
PROJECT_NAME="MPLADS AI Sentinel"
VERSION="1.0.0"

# Database Configuration (MongoDB)
# Production (MongoDB Atlas free M0 cluster):
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name on the cluster (tests point this at a throwaway database):
MONGO_DB_NAME=mplads_sentinel

# API Configuration
API_PREFIX=/api
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Live MPLADS Dashboard API (mplads.mospi.gov.in /digigov) — the only data
# source. The "live" sync mode pulls fresh per-work records from the
# dashboard's own REST endpoint. Houses: rajya_sabha (fast, ~60k rows) |
# lok_sabha (current term, ~90 MB payloads, minutes) | lok_sabha_17 | both.
MPLADS_LIVE_HOUSE=both
MPLADS_LIVE_TIMEOUT=300

# Serverless deployment (Vercel) configuration
# Set automatically by Vercel; set to 1 to disable APScheduler + background bootstrap locally.
# IS_SERVERLESS=1
# On first boot with an empty database, ingest the bundled sample CSV so the
# deployment shows data immediately (serverless-friendly, synchronous).
SEED_FROM_SAMPLE=1
# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# to authenticate GET /api/cron/sync. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=replace_with_a_secure_random_secret
