# ==============================================================================
# MPLADS AI Sentinel Environment Configuration Example
# Copy to .env and adjust values for your deployment environment.
# ==============================================================================

# Application Environment (development / staging / production)
ENVIRONMENT=development
PROJECT_NAME="MPLADS AI Sentinel"
VERSION="1.0.0"

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# In development, defaults to mongodb://localhost:27017 if unset.
# In production, MONGODB_URI is REQUIRED and must point to a production cluster (e.g. MongoDB Atlas).
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=mplads_sentinel

# ------------------------------------------------------------------------------
# Security & Authentication (JWT & Admin)
# ------------------------------------------------------------------------------
# In development, defaults to a local test secret.
# In production, JWT_SECRET is REQUIRED and must be a unique, cryptographically strong secret.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=mplads-sentinel-jwt-secret-key-32-chars-min!
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial admin account setup (used to seed account on first boot in development)
# In production, default password Admin@MPLADS2026! is rejected at startup.
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASSWORD=Admin@MPLADS2026!

# ------------------------------------------------------------------------------
# Networking & CORS Configuration
# ------------------------------------------------------------------------------
API_PREFIX=/api
PORT=8000
HOST=0.0.0.0

# Allowed frontend origins (comma separated). Set to your deployed frontend domain in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Live MPLADS Dashboard Ingestion API
# ------------------------------------------------------------------------------
# Houses: rajya_sabha | lok_sabha_18 | lok_sabha_17 | both | all
MPLADS_BASE_URL=https://mplads.mospi.gov.in
MPLADS_LIVE_HOUSE=both
MPLADS_LIVE_TIMEOUT=300

# ------------------------------------------------------------------------------
# Startup Seeding & Scheduled Automation
# ------------------------------------------------------------------------------
# AUTO_SEED: Automatically seed accounts and initial data on process startup.
# Defaults to 1 in development, 0 in production.
AUTO_SEED=1

# SEED_FROM_SAMPLE: Ingest bundled sample CSV if database is completely empty.
# Defaults to 1 in development, 0 in production.
SEED_FROM_SAMPLE=1

# Set to 1 if deploying to serverless environments (Vercel) to disable background scheduler.
IS_SERVERLESS=0

# Shared secret for authenticating POST /api/cron/sync calls.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=replace_with_a_secure_random_secret
